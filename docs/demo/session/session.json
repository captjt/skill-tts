{
  "_comment": "Condensed replay of a real headless Claude Code session (claude -p) using the globally installed skill. Tool calls and outputs are verbatim except: the launcher path is shortened to ~, long outputs are truncated the way Claude Code truncates them, and two detours (reading providers.md, an extra ffmpeg padding step) are omitted. 'at' is the replay time in seconds.",
  "cwd": "~/launch-video",
  "file": "voiceover/voiceover.wav",
  "prompt": "Write a 12-second, 3-scene launch voiceover for skill-tts. Hook: this narration was written by Claude. Render it with ElevenLabs.",
  "typeStart": 0.35,
  "typeDur": 2.3,
  "steps": [
    { "at": 2.95, "type": "tool", "name": "Skill", "args": "tts" },
    { "at": 3.1, "type": "out", "text": "Launching skill: tts" },
    { "at": 3.55, "type": "tool", "name": "Bash", "args": "~/.claude/skills/tts/scripts/tts voices -p elevenlabs" },
    { "at": 3.7, "type": "out", "text": "pNInz6obpgDQGcFmaJgB  Adam - Dominant, Firm  male, american…" },
    { "at": 3.8, "type": "cont", "text": "… +26 lines" },
    { "at": 4.25, "type": "tool", "name": "Write", "args": "script.json" },
    { "at": 4.4, "type": "out", "text": "Wrote 11 lines to script.json" },
    { "at": 4.85, "type": "tool", "name": "Bash", "args": "~/.claude/skills/tts/scripts/tts render script.json -o voiceover/" },
    { "at": 5.45, "type": "out", "text": "[1/3] 01-hook: 1.65s" },
    { "at": 5.85, "type": "cont", "text": "[2/3] 03-cta: 2.59s" },
    { "at": 6.3, "type": "cont", "text": "[3/3] 02-render: 4.43s" },
    { "at": 6.4, "type": "cont", "text": "… +52 lines (manifest.json)" },
    { "at": 5.0, "until": 6.45, "type": "spin", "text": "Rendering with ElevenLabs…" },
    { "at": 6.95, "type": "say", "text": "Rendered with ElevenLabs, voice “Eric”: 9.5 s of speech." },
    { "at": 7.15, "type": "row", "id": "01-hook", "range": "0.00 – 1.65s", "dur": "“This narration was written by Claude.”" },
    { "at": 7.3, "type": "row", "id": "02-render", "range": "2.05 – 6.48s", "dur": "“…timed scene by scene, captions included.”" },
    { "at": 7.45, "type": "row", "id": "03-cta", "range": "6.88 – 9.48s", "dur": "“Give Claude a voice…”" }
  ]
}
